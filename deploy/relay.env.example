# Sparshur relay environment for a private VPN deployment.
# Linux: install as /etc/sparshur-relay/relay.env (read by the systemd unit).
# macOS: launchd does not read env files; set the same keys in the plist.

# Keep the plaintext listener on loopback. The TLS terminator on this host
# (tailscale serve or Caddy) is the only thing that should reach it.
RELAY_ADDR=127.0.0.1:8080

# Everything below is optional; values shown are the built-in defaults.
#RELAY_MAX_MESSAGE_BYTES=1048576
#RELAY_SEND_QUEUE_SIZE=64
#RELAY_PING_INTERVAL=25s
#RELAY_WRITE_TIMEOUT=10s
#RELAY_SHUTDOWN_TIMEOUT=15s
#RELAY_ALLOWED_ORIGINS=
#RELAY_LOG_LEVEL=info
